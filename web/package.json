{
  "name": "jinx-web",
  "version": "0.1.0",
  "private": true,
  "description": "Static marketing site for Jinx. Every number is generated from research/experiments/results by scripts/make_data.py.",
  "scripts": {
    "data": "python3 scripts/make_data.py",
    "dev": "next dev",
    "build": "next build",
    "start": "python3 -m http.server 3000 --directory out",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "15.5.29",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.35.0",
    "eslint-config-next": "15.5.29",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2"
  }
}
